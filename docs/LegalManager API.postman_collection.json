    {
      "name": "4. Documentos",
      "item": [
        {
          "name": "Subir documento",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/document"
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "caseId",
                  "type": "text",
                  "value": "{{caseId}}"
                },
                {
                  "key": "type",
                  "type": "text",
                  "value": "Escrito"
                },
                {
                  "key": "uploadedByUserId",
                  "type": "text",
                  "value": "{{lawyerId}}"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": "./subir.pdf",
                  "description": "PDF de prueba. Colocá uno en esa ruta o elegí el archivo al ejecutar."
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('uploadedDocumentId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar documentos del expediente",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/document/case/{{caseId}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Respuesta es una lista', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener documento por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/document/{{uploadedDocumentId}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Respuesta es un documento', () => pm.expect(pm.response.json()).to.have.property('id'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Descargar documento",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/document/{{uploadedDocumentId}}/download"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Generar resumen IA",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/document/case/{{caseId}}/generate-summary?generatedByUserId={{lawyerId}}",
              "query": [
                {
                  "key": "generatedByUserId",
                  "value": "{{lawyerId}}",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Documento generado por IA', () => pm.expect(pm.response.json().generatedByAI).to.eql(true));",
                  "pm.collectionVariables.set('documentId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Revisar resumen IA",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/document/{{documentId}}/approve"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"reviewedByUserId\":\"{{lawyerId}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Documento aprobado', () => pm.expect(pm.response.json().approved).to.eql(true));",
                  "pm.test('Revisado por el abogado', () => pm.expect(pm.response.json().reviewedByUserId).to.eql(pm.collectionVariables.get('lawyerId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "NEGATIVO: revisar documento manual (409)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/document/{{uploadedDocumentId}}/approve"
            },
