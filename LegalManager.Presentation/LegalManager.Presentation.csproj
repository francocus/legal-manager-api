      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LegalManager.Application\LegalManager.Application.csproj" />
    <ProjectReference Include="..\LegalManager.Infrastructure\LegalManager.Infrastructure.csproj" />
  </ItemGroup>

</Project>
