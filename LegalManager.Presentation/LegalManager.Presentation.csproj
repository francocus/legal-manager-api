    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>1b0b6b28-6335-415c-b2cd-6fa92b0fc1a2</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
