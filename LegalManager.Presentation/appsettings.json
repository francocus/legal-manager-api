{
  "Jwt": {
    "Key": "",
    "Issuer": "LegalManager.Api",
    "Audience": "LegalManager.Clients",
    "ExpirationMinutes": 60
  },
  "Llm": {
    "BaseUrl": "https://opencode.ai/inference/go/openai",
    "Model": "glm-5.3-flash",
    "MaxOutputTokens": 800,
    "Temperature": 0.4,
    "Resilience": {
      "RetryCount": 3,
      "InitialDelaySeconds": 2,
      "BackoffFactor": 2.0,
      "BreakerFailuresBeforeOpen": 5,
      "BreakerOpenDurationSeconds": 30,
      "TimeoutSeconds": 20
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}